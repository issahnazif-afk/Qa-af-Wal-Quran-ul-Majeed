{
  "name": "quran-library",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "astro dev",
    "build": "node scripts/build-data.mjs && astro build",
    "build:site": "astro build",
    "preview": "astro preview",
    "build:app": "node scripts/build-data.mjs && APP_BUILD=1 PUBLIC_APP_BUILD=1 astro build",
    "build:app:site": "APP_BUILD=1 PUBLIC_APP_BUILD=1 astro build"
  },
  "dependencies": {
    "astro": "7.3.8",
    "@capacitor/core": "7.6.9",
    "@capacitor-community/speech-recognition": "7.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@capacitor/android": "7.6.9",
    "@capacitor/ios": "7.6.9",
    "@capacitor/assets": "3.0.5"
  }
}