---
import Base from '../../layouts/Base.astro';
import Player from '../../components/Player.astro';
import QuranBar from '../../components/QuranBar.astro';
import cfg from '../../../site.config.mjs';
import { getMeta, getSurah, getLayout, arNum } from '../../lib/data.mjs';
import { tokenize, qpc } from '../../lib/recite.mjs';
import { u } from '../../lib/url.mjs';

export function getStaticPaths() {
  return Array.from({ length: getMeta().pages.length }, (_, i) => ({ params: { n: String(i + 1) } }));
}
const n = Number(Astro.params.n);
const total = getMeta().pages.length;
// In a spread the odd page is on the right and the even page on the left, as in a printed mushaf.
const right = n % 2 ? n : n - 1;
const pair = [right, right + 1].filter((p) => p >= 1 && p <= total);

const toks = new Map();
const words = (s, a) => {
  const k = `${s}:${a}`;
  if (!toks.has(k)) toks.set(k, tokenize(getSurah(s).ayahs[a - 1].ar, k));
  return toks.get(k);
};
function pageData(p) {
  const layout = getLayout(p);
  const onPage = [...new Set(layout.lines.filter((l) => l.t === 'a').flatMap((l) => l.w.map((w) => w[0])))];
  const ayahs = [];
  for (const l of layout.lines) if (l.t === 'a') for (const [s, a, wi] of l.w) if (wi === -1) ayahs.push([s, a]);
  return { p, layout, names: onPage.map((s) => getSurah(s).ar).join(' · '), ayahs };
}
const pages = pair.map(pageData);
const here = pages.find((x) => x.p === n);
const enNames = [...new Set(here.ayahs.map(([s]) => getSurah(s).en))].join(', ');
const trOf = (s, a) => getSurah(s).ayahs[a - 1].tr[cfg.defaultTranslation] ?? '';
---
<Base title={`Mushaf page ${n}`} active="mushaf" description={`Page ${n} of the Madani mushaf: ${enNames}.`}>
  <style is:global>
    .mushaf-v2 .bar { background: var(--surface); border-bottom: 1px solid var(--line); }
    .mushaf-v2 .bar .wrap { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; padding-top: 10px; padding-bottom: 10px; }
    .mushaf-v2 .spacer { flex: 1 1 auto; }
    .mushaf-v2 .spread.dragging { transition: none; }
    .mushaf-v2 .spread.settle { transition: transform .22s cubic-bezier(.2,.7,.2,1), opacity .22s; }
    .mushaf-v2 .spread { will-change: transform; display: flex; flex-direction: row; justify-content: center; gap: 18px; padding: 20px 16px 28px; direction: rtl; touch-action: pan-y; }
    .mushaf-v2 .paper { flex: 0 1 600px; min-width: 0; aspect-ratio: 0.66; background: var(--paper); border: 1px solid var(--paper-line); border-radius: 6px; padding: 22px clamp(12px, 3.2vw, 34px) 16px; display: flex; flex-direction: column; gap: 8px; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
    .mushaf-v2 .paper.partner { display: none; }
    @media (min-width: 1100px) and (orientation: landscape) {
      .mushaf-v2.can-spread .paper.partner { display: flex; }
      .mushaf-v2.can-spread .paper { flex-basis: 560px; }
    }
    .mushaf-v2 .mp-lines { flex: 1 1 auto; justify-content: space-between; }
    .mushaf-v2 .mp-line [data-k] { cursor: pointer; border-radius: 4px; }
    .mushaf-v2 .mp-line .sel { background: var(--accent-soft); }
    .mushaf-v2 .mp-line .playing { background: var(--mark); }
    .mushaf-v2 .info { max-width: 640px; margin: 0 auto 24px; padding: 14px 18px; display: flex; flex-direction: column; gap: 8px; }
    .mushaf-v2 .info-actions { display: flex; flex-wrap: wrap; gap: 8px; }
    .mushaf-v2 .hintline { text-align: center; font-size: 13px; color: var(--muted); margin: -12px 0 16px; }
    @media (max-width: 700px) {
      .mushaf-v2 .bar .wrap { gap: 6px; padding-top: 8px; padding-bottom: 8px; }
      .mushaf-v2 .bar .btn { padding: 0 12px; font-size: 14px; }
      .mushaf-v2 .bar .muted, .mushaf-v2 .spacer { display: none; }
      .mushaf-v2 .spread { padding: 10px 6px 18px; }
      .mushaf-v2 .paper { padding: 14px 10px 10px; }
    }
    html[data-app] .mushaf-v2 .bar, html[data-app] .mushaf-v2 .hintline { display: none; }
    html[data-app] .mushaf-v2 .spread { padding: 8px 6px 12px; }
    html[data-app] .mushaf-v2 .paper { border-radius: 4px; box-shadow: none; }
    .mushaf-v2 .trbox { position: fixed; left: 10px; right: 10px; bottom: calc(108px + env(safe-area-inset-bottom, 0px)); z-index: 31; padding: 12px 14px; font-size: 15px; line-height: 1.55; max-height: 30vh; overflow-y: auto; }
    body.focus .site-header, body.focus .site-footer, body.focus .mushaf-v2 .bar, body.focus .mushaf-v2 .hintline { display: none; }
    body.focus .mushaf-v2 .spread { min-height: 100vh; align-items: center; padding: 8px; }
    body.focus .mushaf-v2 .paper { max-height: calc(100vh - 16px); }
    .mushaf-v2 .exit-focus { position: fixed; top: 10px; left: 10px; z-index: 40; display: none; }
    body.focus .mushaf-v2 .exit-focus { display: inline-flex; }
  </style>

  <div class="mushaf-v2" id="mushaf" data-n={n} data-total={total} data-right={right}>
    <div class="bar">
      <div class="wrap">
        {n < total ? <a class="btn" href={u(`page/${n + 1}/`)} rel="next" id="go-next" aria-label="Next page">← Next</a> : <span class="btn" aria-disabled="true">← Next</span>}
        <form class="control" id="jump">
          <label class="field-label" for="pg">Page</label>
          <input class="field" id="pg" type="number" min="1" max={total} value={n} style="width:84px" />
          <span class="muted">of {total}</span>
        </form>
        {n > 1 ? <a class="btn" href={u(`page/${n - 1}/`)} rel="prev" id="go-prev" aria-label="Previous page">Previous →</a> : <span class="btn" aria-disabled="true">Previous →</span>}
        <span class="muted" id="where">{enNames}, juz {here.layout.juz}</span>
        <span class="spacer"></span>
        <label class="control" style="min-height:44px"><input type="checkbox" id="spread" style="width:18px;height:18px" /> Two pages</label>
        <button class="btn" type="button" id="focus">Focus mode</button>
        <button class="btn btn-primary" type="button" id="play-page">Play page</button>
      </div>
    </div>

    <div class="spread" id="spread-box">
      {pages.map((pg) => (
        <article class={'paper mp' + (pg.p === n ? '' : ' partner')} lang="ar" dir="rtl" aria-label={`Mushaf page ${pg.p}`} data-p={pg.p}>
          <div class="mp-head"><span>{pg.names}</span><span>الجزء {arNum(pg.layout.juz)}</span></div>
          <div class="mp-lines">
            {pg.layout.lines.map((l) =>
              l.t === 's' ? <div class="mp-line mp-banner">سورة {getSurah(l.s).ar}</div>
              : l.t === 'b' ? <div class="mp-line mp-bism c">{qpc(getSurah(l.s).bismillah ?? '')}</div>
              : (
                <div class={'mp-line' + (l.c ? ' c' : '')}>
                  {l.w.map(([s, a, wi], k) => (
                    <>{k > 0 && ' '}{wi === -1
                      ? <span class="mk" data-k={`${s}:${a}`}>﴿{arNum(a)}﴾</span>
                      : <span data-k={`${s}:${a}`}>{words(s, a)[wi].display}</span>}</>
                  ))}
                </div>
              )
            )}
          </div>
          <div class="mp-folio">{arNum(pg.p)}</div>
        </article>
      ))}
    </div>
    <p class="hintline">Swipe or use the arrow keys to turn pages. Tap an ayah for its translation.</p>
    <div class="tj-legend" aria-label="Tajweed colours">
      <span><i class="tj-ham_wasl">●</i> silent / hamzat al-wasl</span>
      <span><i class="tj-madda_normal">●</i> madd 2</span>
      <span><i class="tj-madda_permissible">●</i> madd 2, 4, 6</span>
      <span><i class="tj-madda_obligatory">●</i> madd 4–5</span>
      <span><i class="tj-madda_necessary">●</i> madd 6</span>
      <span><i class="tj-ghunnah">●</i> ghunnah</span>
      <span><i class="tj-ikhafa">●</i> ikhfa</span>
      <span><i class="tj-idgham_ghunnah">●</i> idgham</span>
      <span><i class="tj-iqlab">●</i> iqlab</span>
      <span><i class="tj-qalaqah">●</i> qalqalah</span>
    </div>

    <section class="card info" id="info" hidden aria-live="polite">
      <b id="info-key"></b>
      <p id="info-tr" style="margin:0;font-size:16px;line-height:1.6" lang="en"></p>
      <div class="info-actions">
        <button class="btn" type="button" id="info-play">Play</button>
        <a class="btn" id="info-study" href="#">Study this ayah</a>
        <a class="btn" id="info-read" href="#">Listen in surah view</a>
      </div>
    </section>

    <button class="btn exit-focus" type="button" id="exit-focus">Exit focus</button>
  </div>

  <div class="app-dock" id="dock" aria-label="Controls">
    <div class="dock-l">
      <button type="button" class="pill" id="dk-tj" aria-pressed="false">Tajweed</button>
      <button type="button" class="pill" id="dk-tr" aria-pressed="false" hidden>Translation</button>
    </div>
    <button type="button" class="fab" id="dk-play" aria-label="Listen">
      <svg data-i="play" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z"></path></svg>
      <svg data-i="pause" hidden width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 4h4v16H6zM14 4h4v16h-4z"></path></svg>
    </button>
    <div class="dock-r"><span class="muted" id="dk-hint" style="font-size:12px;text-align:right">Swipe right for the next page</span></div>
  </div>
  <section class="card trbox" id="dk-trbox" hidden aria-live="polite"><b id="dk-trkey" style="font-size:13px;color:var(--accent-strong)"></b><p id="dk-trtext" style="margin:4px 0 0"></p></section>

  <Player />
  <QuranBar mode="mushaf" s={here.ayahs[0][0]} a={here.ayahs[0][1]} />

  <script>
    import { initPlayer, lastRead, store, getJson, pad } from '../../lib/client.mjs';
    import { buildPaper, fitPaper, arNum } from '../../lib/mushaf.mjs';
    import { u } from '../../lib/url.mjs';

    const root = document.getElementById('mushaf');
    const total = Number(root.dataset.total);
    let n = Number(root.dataset.n);
    const box = document.getElementById('spread-box');
    const spreadToggle = document.getElementById('spread');
    const wide = matchMedia('(min-width: 1100px) and (orientation: landscape)');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const script = () => document.documentElement.dataset.script || store.get('script', 'plain');
    const riwayah = () => document.documentElement.dataset.riwayah || 'hafs';
    const rightOf = (p) => (p % 2 ? p : p - 1);

    // ── two-page spreads on wide screens ──────────────────────
    spreadToggle.checked = store.get('spread', true);
    const spreading = () => spreadToggle.checked && wide.matches;
    function applySpread() {
      root.classList.toggle('can-spread', spreadToggle.checked);
      spreadToggle.closest('label').hidden = !wide.matches;
      render(n, 0);
    }
    spreadToggle.addEventListener('change', () => { store.set('spread', spreadToggle.checked); applySpread(); });
    wide.addEventListener?.('change', applySpread);

    function fitAll() { box.querySelectorAll('.paper').forEach((p) => { if (p.offsetParent) fitPaper(p); }); }
    let rt;
    addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(fitAll, 150); });

    // ── drawing pages in the browser, so turning is instant ───
    async function papersFor(p) {
      const pages = spreading() ? [rightOf(p), rightOf(p) + 1].filter((x) => x >= 1 && x <= total) : [p];
      return Promise.all(pages.map(async (x) => {
        const paper = await buildPaper(x, { getJson, pad, script: script(), riwayah: riwayah() });
        if (x !== p) paper.classList.add('partner');
        return paper;
      }));
    }
    function preload(p) {
      for (const x of [p + 1, p + 2, p - 1, p - 2]) if (x >= 1 && x <= total) getJson(`layout/${pad(x)}.json`).then((l) => {
        for (const line of l.lines) if (line.t === 'a') for (const [s] of line.w) getJson(`surah/${pad(s)}.json`).catch(() => {});
      }).catch(() => {});
    }

    let busy = false;
    async function render(p, dir) {
      if (busy) return;
      busy = true;
      try {
        const papers = await papersFor(p);
        n = p;
        if (dir && !reduceMotion) {
          box.classList.add('settle');
          box.style.transform = `translateX(${dir > 0 ? 40 : -40}px)`;   // RTL: the next page comes in from the left
          box.style.opacity = '0';
        }
        box.replaceChildren(...papers);
        await Promise.all(papers.filter((x) => x.offsetParent).map((x) => fitPaper(x)));
        requestAnimationFrame(() => { box.style.transform = ''; box.style.opacity = ''; });
        setTimeout(() => box.classList.remove('settle'), 260);
        afterRender();
      } finally { busy = false; }
    }

    async function afterRender() {
      document.getElementById('pg').value = String(n);
      document.title = document.title.replace(/page \d+/, `page ${n}`);
      if (location.pathname !== u(`page/${n}/`)) {
        const q = new URLSearchParams(location.search); q.delete('k');
        history.replaceState(null, '', u(`page/${n}/`) + (q.toString() ? `?${q}` : ''));
      }
      const first = box.querySelector('.paper:not(.partner) [data-k]') ?? box.querySelector('[data-k]');
      if (first) {
        const [s, a] = first.dataset.k.split(':').map(Number);
        const sura = await getJson(`surah/${pad(s)}.json`);
        document.getElementById('where').textContent = `${sura.en}, juz ${sura.ayahs[a - 1].juz}`;
        document.dispatchEvent(new CustomEvent('ql:pos', { detail: { s, a } }));
      }
      preload(n);
    }

    function go(delta) {
      const step = spreading() ? 2 : 1;
      const base = spreading() ? rightOf(n) : n;
      const target = Math.min(total, Math.max(1, base + delta * step));
      if (target === base) return;
      render(target, delta);
    }

    // ── controls: buttons, keys, swipe ────────────────────────
    document.getElementById('jump').addEventListener('submit', (e) => {
      e.preventDefault();
      const v = Math.min(total, Math.max(1, parseInt(document.getElementById('pg').value, 10) || 1));
      render(v, v > n ? 1 : -1);
    });
    document.getElementById('go-next')?.addEventListener('click', (e) => { e.preventDefault(); go(1); });
    document.getElementById('go-prev')?.addEventListener('click', (e) => { e.preventDefault(); go(-1); });
    document.addEventListener('keydown', (e) => {
      if (e.target.closest('input, select, textarea')) return;
      if (e.key === 'ArrowLeft') go(1);          // the mushaf reads right to left: the next page is to the left
      if (e.key === 'ArrowRight') go(-1);
      if (e.key === 'Escape' && document.body.classList.contains('focus')) setFocus(false);
    });
    // the page follows your finger; let go past a third of a thumb and it turns
    let sx = null, sy = null, dx = 0, horiz = null;
    box.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; dx = 0; horiz = null; }, { passive: true });
    box.addEventListener('touchmove', (e) => {
      if (sx === null) return;
      dx = e.touches[0].clientX - sx;
      const dy = e.touches[0].clientY - sy;
      if (horiz === null && Math.abs(dx) + Math.abs(dy) > 10) horiz = Math.abs(dx) > Math.abs(dy);
      if (horiz) { box.classList.add('dragging'); box.style.transform = `translateX(${dx}px)`; box.style.opacity = String(1 - Math.min(0.5, Math.abs(dx) / 600)); }
    }, { passive: true });
    box.addEventListener('touchend', () => {
      if (sx === null) return;
      box.classList.remove('dragging');
      const moved = horiz && Math.abs(dx) > 60;
      sx = null;
      if (moved) go(dx > 0 ? 1 : -1);    // swipe right = next page
      else { box.classList.add('settle'); box.style.transform = ''; box.style.opacity = ''; setTimeout(() => box.classList.remove('settle'), 260); }
    });

    // ── focus mode ────────────────────────────────────────────
    function setFocus(on) {
      document.body.classList.toggle('focus', on);
      try { if (on) document.documentElement.requestFullscreen?.(); else if (document.fullscreenElement) document.exitFullscreen(); } catch {}
      setTimeout(fitAll, 120);
    }
    document.getElementById('focus').addEventListener('click', () => setFocus(true));
    document.getElementById('exit-focus').addEventListener('click', () => setFocus(false));
    document.addEventListener('fullscreenchange', () => { if (!document.fullscreenElement) { document.body.classList.remove('focus'); fitAll(); } });

    // ── tapping an ayah ───────────────────────────────────────
    const info = document.getElementById('info');
    let selKey = null;
    function mark(cls, key) {
      box.querySelectorAll(`.${cls}`).forEach((x) => x.classList.remove(cls));
      if (key) box.querySelectorAll(`[data-k="${key}"]`).forEach((x) => x.classList.add(cls));
    }
    async function select(key) {
      selKey = key;
      const [s, a] = key.split(':').map(Number);
      const sura = await getJson(`surah/${pad(s)}.json`);
      const ay = sura.ayahs[a - 1];
      mark('sel', key);
      document.getElementById('info-key').textContent = `${sura.en} ${key}`;
      document.getElementById('info-tr').textContent = Object.values(ay.tr)[0] ?? '';
      document.getElementById('info-study').href = u(`ayah/?k=${key}`);
      document.getElementById('info-read').href = u(`surah/${s}/#a${a}`);
      info.hidden = false;
      lastRead.set({ s, a });
      document.dispatchEvent(new CustomEvent('ql:pos', { detail: { s, a } }));
    }
    box.addEventListener('click', (e) => { const w = e.target.closest('[data-k]'); if (w) select(w.dataset.k); });

    // ── the bottom bar: go to a surah and ayah, change the script ──
    document.addEventListener('ql:goto', async (e) => {
      e.preventDefault();
      const { s, a } = e.detail;
      const sura = await getJson(`surah/${pad(s)}.json`);
      const p = sura.ayahs[a - 1].page;
      if (p !== n) await render(p, p > n ? 1 : -1);
      select(`${s}:${a}`);
      box.querySelector(`[data-k="${s}:${a}"]`)?.scrollIntoView({ block: 'center', behavior: reduceMotion ? 'auto' : 'smooth' });
    });
    document.addEventListener('ql:script', () => render(n, 0));
    document.addEventListener('ql:riwayah', () => render(n, 0));

    // ── listening ─────────────────────────────────────────────
    const player = initPlayer({ lazy: true });   // the audio bar appears when you press play
    async function visibleQueue() {
      const keys = [...new Set([...box.querySelectorAll('.paper .mk[data-k]')].filter((x) => x.offsetParent).map((x) => x.dataset.k))];
      return Promise.all(keys.map(async (k) => {
        const [s, a] = k.split(':').map(Number);
        const sura = await getJson(`surah/${pad(s)}.json`);
        return { s, a, label: `${sura.en}, ${k}` };
      }));
    }
    document.getElementById('play-page').addEventListener('click', async () => { player.setQueue(await visibleQueue()); player.playAll(); });
    document.getElementById('info-play').addEventListener('click', async () => { if (!selKey) return; player.setQueue(await visibleQueue()); player.playAt(selKey); });
    document.addEventListener('ql:ayah', (e) => mark('playing', e.detail.key));

    // ── app dock: Tajweed, Translation (Listen only), and one big play button ──
    const listenMode = new URLSearchParams(location.search).get('listen') === '1';
    const dkTj = document.getElementById('dk-tj');
    const dkTr = document.getElementById('dk-tr');
    const dkPlay = document.getElementById('dk-play');
    const trBox = document.getElementById('dk-trbox');
    const scriptSel = document.getElementById('qb-script');
    const tjOk = () => !scriptSel.querySelector('option[value="tajweed"]').disabled;
    const syncTj = () => { dkTj.hidden = !tjOk(); dkTj.setAttribute('aria-pressed', String(scriptSel.value === 'tajweed')); };
    dkTj.addEventListener('click', () => {
      scriptSel.value = scriptSel.value === 'tajweed' ? 'plain' : 'tajweed';
      scriptSel.dispatchEvent(new Event('change'));
      syncTj();
    });
    document.addEventListener('ql:riwayah', syncTj);
    syncTj();
    dkTr.hidden = !listenMode;
    const trOn = () => dkTr.getAttribute('aria-pressed') === 'true';
    dkTr.addEventListener('click', () => { dkTr.setAttribute('aria-pressed', String(!trOn())); if (!trOn()) trBox.hidden = true; });
    if (listenMode) document.getElementById('dk-hint').textContent = 'The page follows the reciter';

    const pBtn = document.querySelector('#player [data-p="play"]');
    let started = false;
    new MutationObserver(() => {
      const playing = pBtn.getAttribute('aria-label') === 'Pause';
      dkPlay.querySelector('[data-i="play"]').hidden = playing;
      dkPlay.querySelector('[data-i="pause"]').hidden = !playing;
      dkPlay.setAttribute('aria-label', playing ? 'Pause' : 'Listen');
    }).observe(pBtn, { attributes: true, attributeFilter: ['aria-label'] });
    async function listenQueue() {
      // Listen: from the first ayah on this page onwards, through the following surahs, turning pages as it goes
      const firstOnPage = box.querySelector('.paper:not(.partner) [data-k]')?.dataset.k.split(':').map(Number) ?? [1, 1];
      const meta = await getJson('meta.json');
      const q = [];
      for (let s = firstOnPage[0]; s <= 114 && q.length < 2000; s++) {
        const info = meta.surahs[s - 1];
        for (let a = s === firstOnPage[0] ? firstOnPage[1] : 1; a <= info.ayahs; a++) q.push({ s, a, label: `${info.en}, ${s}:${a}` });
      }
      return q;
    }
    dkPlay.addEventListener('click', async () => {
      if (started) { pBtn.click(); return; }
      started = true;
      player.setQueue(listenMode ? await listenQueue() : await visibleQueue());
      player.playAll();
    });
    document.addEventListener('ql:ayah', async (e) => {
      const key = e.detail.key;
      if (!key) return;
      const [s, a] = key.split(':').map(Number);
      const sura = await getJson(`surah/${pad(s)}.json`);
      const ay = sura.ayahs[a - 1];
      if (listenMode && ay.page !== n && !(spreading() && rightOf(ay.page) === rightOf(n))) { await render(ay.page, ay.page > n ? 1 : -1); mark('playing', key); }
      if (listenMode && trOn()) {
        document.getElementById('dk-trkey').textContent = `${sura.en} ${key}`;
        document.getElementById('dk-trtext').textContent = Object.values(ay.tr)[0] ?? '';
        trBox.hidden = false;
      }
      document.dispatchEvent(new CustomEvent('ql:pos', { detail: { s, a } }));
    });

    // ── start ─────────────────────────────────────────────────
    (async () => {
      const k = new URLSearchParams(location.search).get('k');
      // The first page is already in the HTML; redraw it only if it needs tajweed colours or the second page.
      root.classList.toggle('can-spread', spreadToggle.checked);
