---
import Base from '../../layouts/Base.astro';
import cfg from '../../../site.config.mjs';
const trName = cfg.translations.find((t) => t.id === cfg.defaultTranslation)?.name;
---
<Base title="Search" active="search">
  <style is:global>
    .search-page.page { padding-top: 36px; display: flex; flex-direction: column; gap: 18px; }
    .search-page #q { height: 56px; font-size: 18px; padding: 0 18px; border: 2px solid var(--accent); border-radius: 12px; width: 100%; }
    .search-page .hint { padding: 16px; display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; text-decoration: none; color: var(--ink); background: var(--accent-soft); border: none; }
    .search-page .res { padding: 18px 20px; display: flex; flex-direction: column; gap: 8px; text-decoration: none; color: var(--ink); }
    .search-page .res:hover { border-color: var(--accent); color: var(--ink); }
    .search-page .res-top { display: flex; justify-content: space-between; gap: 12px; font-size: 14px; }
    .search-page .res-key { font-weight: 600; color: var(--accent-strong); }
    .search-page .res .quran { font-size: 24px; line-height: 1.9; }
  
  </style>
  <div class="narrow page search-page">
    <form role="search" id="form" style="display:flex;flex-direction:column;gap:8px">
      <label class="field-label" for="q">Search the Quran</label>
      <input class="field" id="q" name="q" type="search" autocomplete="off" placeholder="Try: mercy, 2:255, page 42, Yusuf, or Arabic like الرحمن" />
    </form>
    <div id="hints" style="display:flex;flex-direction:column;gap:8px"></div>
    <p class="muted" id="status" style="margin:0;font-size:14px" aria-live="polite">Searches the Arabic text and {trName}. It runs in your browser.</p>
    <div id="results" style="display:flex;flex-direction:column;gap:10px"></div>
  </div>

  <script>
    import { getJson } from '../../lib/client.mjs';
    import { u } from '../../lib/url.mjs';

    const qEl = document.getElementById('q');
    const hints = document.getElementById('hints');
    const results = document.getElementById('results');
    const status = document.getElementById('status');
    const LIMIT = 200;

    const plainAr = (s) => s.replace(/[\u0610-\u061A\u064B-\u065F\u0670\u06D6-\u06ED\u0640]/g, '')
      .replace(/[ٱأإآ]/g, 'ا').replace(/ى/g, 'ي').replace(/ة/g, 'ه').replace(/\s+/g, ' ').trim();
    const simple = (s) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]/g, '');
    const el = (tag, props = {}, text) => { const e = Object.assign(document.createElement(tag), props); if (text != null) e.textContent = text; return e; };

    function highlight(parent, text, q, isAr) {
      if (isAr) { parent.textContent = text; return; }
      const i = text.toLowerCase().indexOf(q.toLowerCase());
      if (i < 0) { parent.textContent = text; return; }
      parent.append(text.slice(0, i), el('mark', {}, text.slice(i, i + q.length)), text.slice(i + q.length));
    }
    function hint(href, title, sub) {
      const a = el('a', { className: 'card hint', href });
      a.append(el('b', {}, title), el('span', {}, sub));
      hints.append(a);
    }

    let index = null;
    async function run() {
      const q = qEl.value.trim();
      hints.replaceChildren(); results.replaceChildren();
      history.replaceState(null, '', q ? `?q=${encodeURIComponent(q)}` : location.pathname);
      if (!q) return;
      const meta = await getJson('meta.json');

      // direct jumps
      let m;
      if ((m = /^(\d{1,3})\s*[:.]\s*(\d{1,3})$/.exec(q))) {
        const s = +m[1], a = +m[2], sura = meta.surahs[s - 1];
        if (sura && a >= 1 && a <= sura.ayahs) hint(u(`ayah/?k=${s}:${a}`), `Go to ${s}:${a}`, `${sura.en}, ayah ${a}`);
      } else if ((m = /^(\d{1,3})$/.exec(q)) && meta.surahs[+m[1] - 1]) {
        const sura = meta.surahs[+m[1] - 1];
        hint(u(`surah/${sura.n}/`), `Surah ${sura.n}`, `${sura.en} (${sura.meaning})`);
      }
      if ((m = /^(?:page|p\.?)\s*(\d{1,3})$/i.exec(q)) && +m[1] >= 1 && +m[1] <= meta.pages.length) {
        hint(u(`page/${m[1]}/`), `Mushaf page ${m[1]}`, 'Open the page');
      }
      const sq = simple(q);
      if (sq.length >= 3) {
        meta.surahs.filter((s) => simple(s.en).includes(sq) || simple(s.meaning).includes(sq)).slice(0, 5)
          .forEach((s) => hint(u(`surah/${s.n}/`), `Surah ${s.n}: ${s.en}`, s.meaning));
      }

      // text search
      if (q.length < 2) { status.textContent = 'Type at least two letters to search the text.'; return; }
      status.textContent = 'Searching…';
      index ??= await getJson('search.json');
      const isAr = /[\u0600-\u06FF]/.test(q);
      const needle = isAr ? plainAr(q) : q.toLowerCase();
      const hits = [];
      for (const row of index) {
        if ((isAr ? row[2] : row[3].toLowerCase()).includes(needle)) { hits.push(row); }
      }
      status.textContent = hits.length
        ? `${hits.length} ayah${hits.length === 1 ? '' : 's'} contain “${q}”${hits.length > LIMIT ? `. Showing the first ${LIMIT}.` : '.'}`
        : `No ayah contains “${q}”. Check the spelling, or try a shorter word.`;
      for (const [s, a, , tr] of hits.slice(0, LIMIT)) {
        const card = el('a', { className: 'card res', href: u(`ayah/?k=${s}:${a}`) });
        const top = el('span', { className: 'res-top' });
        top.append(el('span', { className: 'res-key' }, `${s}:${a}`), el('span', { className: 'muted' }, meta.surahs[s - 1].en));
        const body = el('span', { style: 'font-size:16px;line-height:1.6' });
        highlight(body, tr, q, isAr);
        card.append(top, body);
        results.append(card);
      }
    }

    let t;
    qEl.addEventListener('input', () => { clearTimeout(t); t = setTimeout(run, 250); });
    document.getElementById('form').addEventListener('submit', (e) => { e.preventDefault(); run(); });
    const initial = new URLSearchParams(location.search).get('q');
    if (initial) { qEl.value = initial; run(); }
    qEl.focus();
  </script>
</Base>
