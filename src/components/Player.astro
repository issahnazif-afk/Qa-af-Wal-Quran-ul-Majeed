---
import cfg from '../../site.config.mjs';
---
<div class="player" id="player" hidden aria-label="Audio player" role="region">
  <div class="wrap">
    <button type="button" class="icon-btn" data-p="prev" aria-label="Previous ayah">
      <svg class="svg-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 20 9 12l10-8zM5 19V5"></path></svg>
    </button>
    <button type="button" class="player-play" data-p="play" aria-label="Play">
      <svg data-i="play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z"></path></svg>
      <svg data-i="pause" hidden width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 4h4v16H6zM14 4h4v16h-4z"></path></svg>
    </button>
    <button type="button" class="icon-btn" data-p="next" aria-label="Next ayah">
      <svg class="svg-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 4 10 8-10 8zM19 5v14"></path></svg>
    </button>
    <div style="display:flex;flex-direction:column;min-width:0;flex:1 1 auto">
      <span data-p="title" style="font-weight:600;font-size:15px">Ready to play</span>
      <span data-p="sub" class="muted" style="font-size:13px">Choose an ayah or press play</span>
      <span data-p="error" hidden style="font-size:13px;color:#B3261E">This recitation could not be loaded. Try another reciter.</span>
    </div>
    <div class="player-track" aria-hidden="true"><span data-p="fill"></span></div>
    <label class="visually-hidden" for="reciter-select">Reciter</label>
    <select id="reciter-select" class="field" data-p="reciter">
      {cfg.reciters.map((r) => <option value={r.id}>{r.name}</option>)}
    </select>
    <button type="button" class="btn" data-p="speed" aria-label="Playback speed">1×</button>
    <button type="button" class="btn" data-p="repeat" aria-pressed="false">Repeat ayah</button>
  </div>
</div>
